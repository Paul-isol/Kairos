{
    "compilerOptions": {
        "target":"ES2022",
        "module":"nodenext",
        "moduleResolution":"nodenext",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict":true,
        "esModuleInterop":true,
        "skipLibCheck":true,
        "forceConsistentCasingInFileNames":true,
        "declaration":true,
        "declarationDir":"./dist/types",
        "sourceMap":true,
        "inlineSources":true,
        
    },
    "include":["src/**/*"],
    "exclude": ["node_modules", "dist"]
}